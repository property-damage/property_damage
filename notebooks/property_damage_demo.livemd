# PropertyDamage Interactive Demo

```elixir
Mix.install([
  {:property_damage, "~> 0.2"},
  {:stream_data, "~> 1.0"},
  {:kino, "~> 0.12"}
])
```

## Introduction

This notebook is a hands-on tour of **PropertyDamage**, a stateful
property-based testing framework for Elixir. Instead of testing single inputs,
you describe a *model* of your system, and PropertyDamage generates random
**sequences of operations**, checks your invariants after every step, and — when
it finds a failure — automatically **shrinks** it to a minimal reproduction.

We build one running example: a tiny in-memory **bank**. You will:

1. Define the model — commands, events, a projection with an invariant, a
   simulator, the model, and an adapter.
2. Run the property test against a correct implementation.
3. Read a **coverage** report to confirm the run was not vacuous.
4. Introduce a bug and watch PropertyDamage **find and shrink** it, then debug it.
5. Layer in **chaos engineering** with a nemesis.

The five moving parts:

| Component | Role |
| --- | --- |
| **Command** | A pure generator for one operation's fields (`OpenAccount`, `Credit`, `Debit`). |
| **Event** | The recorded outcome of an operation (`AccountOpened`, `Credited`, ...). |
| **Projection** | A reducer over events that tracks state and asserts invariants. |
| **Simulator** | Predicts events during generation so state-dependent commands become eligible. |
| **Adapter** | Executes a command against the real System Under Test. |

## Part 1 — Define the model

### Events

Events are plain structs describing what happened. A field the *server* assigns
(here, the account id) is marked with `external()` so PropertyDamage tracks it
with a placeholder during generation and resolves it to the real value during
execution.

```elixir
defmodule Demo.Events do
  import PropertyDamage, only: [external: 0]

  defmodule AccountOpened do
    # account_id is minted by the bank (the SUT), so it is external().
    defstruct [:currency, :opening_balance, account_id: external()]
  end

  defmodule Credited do
    defstruct [:account_id, :amount, :new_balance]
  end

  defmodule Debited do
    defstruct [:account_id, :amount, :new_balance]
  end

  defmodule DebitRejected do
    defstruct [:account_id, :amount, :reason]
  end
end
```

### Commands

Commands are **pure data generators**. They know their own fields and how to
generate valid values, but nothing about state. State-dependent choices (which
account to debit, when a command is allowed) live in the Model, not here.

Each command builds a map of `StreamData` generators, pipes it through
`PropertyDamage.Generator.merge_overrides/2` (so the Model can inject
state-derived values), and finishes with `StreamData.fixed_map/1`.

`Credit` and `Debit` default `account_ref` to `nil`; the Model fills it from
state via `with:`.

```elixir
defmodule Demo.Commands.OpenAccount do
  use PropertyDamage.Command
  import PropertyDamage.Generator, only: [merge_overrides: 2]

  defstruct [:currency, :opening_balance]

  @impl true
  def generator(overrides \\ %{}) do
    %{
      currency: StreamData.member_of(["USD", "EUR", "GBP"]),
      opening_balance: StreamData.integer(0..1000)
    }
    |> merge_overrides(overrides)
    |> StreamData.fixed_map()
  end
end

defmodule Demo.Commands.Credit do
  use PropertyDamage.Command
  import PropertyDamage.Generator, only: [merge_overrides: 2]

  defstruct [:account_ref, :amount]

  @impl true
  def generator(overrides \\ %{}) do
    # account_ref is supplied by the Model's `with:` from live state.
    %{account_ref: nil, amount: StreamData.integer(1..500)}
    |> merge_overrides(overrides)
    |> StreamData.fixed_map()
  end
end

defmodule Demo.Commands.Debit do
  # `observables:` is static command metadata (command_spec): the event types
  # this command can produce. Declared once, via `use` options.
  use PropertyDamage.Command,
    observables: [Demo.Events.Debited, Demo.Events.DebitRejected]

  import PropertyDamage.Generator, only: [merge_overrides: 2]

  defstruct [:account_ref, :amount]

  @impl true
  def generator(overrides \\ %{}) do
    %{account_ref: nil, amount: StreamData.integer(1..500)}
    |> merge_overrides(overrides)
    |> StreamData.fixed_map()
  end
end
```

### Projection and invariant

A projection reduces events into state with `apply/2`. Functions tagged
`@trigger` are **invariants**: PropertyDamage runs them at the configured points
and treats a raised exception (via `PropertyDamage.fail!/2`) as a violation. A
returned value is ignored — an invariant signals failure only by raising.

Our invariant is the classic bounds property: **no account balance is ever
negative**. We name it with `@invariant` and link the assertion with
`validates:`, which lets the coverage report tell us the invariant actually
fired.

The `Credited`/`Debited` clauses guard with `Map.has_key?/2` so the projection
stays a total function even while the shrinker explores reduced sequences.

```elixir
defmodule Demo.Bank do
  use PropertyDamage.Model.Projection

  alias Demo.Events.{AccountOpened, Credited, Debited, DebitRejected}

  @impl true
  def init, do: %{accounts: %{}}

  @impl true
  def apply(state, %AccountOpened{account_id: id, currency: c, opening_balance: b}) do
    put_in(state, [:accounts, id], %{currency: c, balance: b})
  end

  def apply(state, %Credited{account_id: id, new_balance: nb}) do
    if Map.has_key?(state.accounts, id),
      do: put_in(state, [:accounts, id, :balance], nb),
      else: state
  end

  def apply(state, %Debited{account_id: id, new_balance: nb}) do
    if Map.has_key?(state.accounts, id),
      do: put_in(state, [:accounts, id, :balance], nb),
      else: state
  end

  def apply(state, %DebitRejected{}), do: state
  def apply(state, _event), do: state

  @invariant id: :balance_non_negative,
             description: "No account balance is ever negative (no overdrafts)"

  @trigger every: 1, validates: :balance_non_negative
  def assert_balance_non_negative(state, _step) do
    negative = Enum.filter(state.accounts, fn {_id, acct} -> acct.balance < 0 end)

    unless negative == [] do
      PropertyDamage.fail!("account balance went negative", accounts: negative)
    end
  end
end
```

### Simulator

During generation the SUT has not run yet, so PropertyDamage asks the
**simulator** to predict each command's events. Those predicted events flow
through the projection to build state, which is what makes state-dependent
commands (a `Debit` needs an account to exist) eligible.

`AccountOpened` leaves `account_id` at its `external()` default — the framework
mints the placeholder. `Debit` predicts a rejection when funds are short: this
is the *model's* view of correct behaviour, and the run later checks the SUT
against it.

```elixir
defmodule Demo.Simulator do
  @behaviour PropertyDamage.Model.Simulator

  alias Demo.Commands.{OpenAccount, Credit, Debit}
  alias Demo.Events.{AccountOpened, Credited, Debited, DebitRejected}

  @impl true
  def simulate(%OpenAccount{currency: c, opening_balance: b}, _state) do
    [%AccountOpened{currency: c, opening_balance: b}]
  end

  def simulate(%Credit{account_ref: ref, amount: amt}, state) do
    bal = get_in(state, [:accounts, ref, :balance]) || 0
    [%Credited{account_id: ref, amount: amt, new_balance: bal + amt}]
  end

  def simulate(%Debit{account_ref: ref, amount: amt}, state) do
    bal = get_in(state, [:accounts, ref, :balance]) || 0

    if bal >= amt do
      [%Debited{account_id: ref, amount: amt, new_balance: bal - amt}]
    else
      [%DebitRejected{account_id: ref, amount: amt, reason: :insufficient_funds}]
    end
  end

  def simulate(_command, _state), do: []
end
```

### Model

The model wires everything together: the weighted command list (with `when:`
preconditions and `with:` state-derived overrides), the projection used for
sequence state, the assertion projections, and the simulator.

```elixir
defmodule Demo.Model do
  @behaviour PropertyDamage.Model

  alias Demo.Commands.{OpenAccount, Credit, Debit}

  @impl true
  def commands do
    [
      {OpenAccount, weight: 3},
      {Credit,
       weight: 3,
       when: fn s -> map_size(s.accounts) > 0 end,
       with: fn s -> %{account_ref: StreamData.member_of(Map.keys(s.accounts))} end},
      {Debit,
       weight: 3,
       when: fn s -> map_size(s.accounts) > 0 end,
       with: fn s -> %{account_ref: StreamData.member_of(Map.keys(s.accounts))} end}
    ]
  end

  @impl true
  def command_sequence_projection, do: Demo.Bank

  @impl true
  def assertion_projections, do: [Demo.Bank]

  @impl true
  def simulator, do: Demo.Simulator
end
```

### Adapter

The adapter executes commands against the real System Under Test. Ours is an
in-memory bank whose state lives in an `Agent` (adapter context returned by
`setup/1` is read-only across commands, so mutable SUT state belongs in a
process, not the return value). `execute/3` returns `{:ok, events}`. Account ids
are minted with `System.unique_integer/1` — no external service required.

This adapter is **correct**: it rejects debits that would overdraw.

```elixir
defmodule Demo.BankAdapter do
  use PropertyDamage.Adapter

  alias Demo.Commands.{OpenAccount, Credit, Debit}
  alias Demo.Events.{AccountOpened, Credited, Debited, DebitRejected}

  @impl true
  def setup(_config) do
    {:ok, store} = Agent.start_link(fn -> %{} end)
    {:ok, %{store: store}}
  end

  @impl true
  def teardown(%{store: store}), do: Agent.stop(store)

  @impl true
  def execute(%OpenAccount{currency: c, opening_balance: b}, %{store: store}, _runtime) do
    id = "acc_#{System.unique_integer([:positive])}"
    Agent.update(store, &Map.put(&1, id, %{currency: c, balance: b}))
    {:ok, [%AccountOpened{account_id: id, currency: c, opening_balance: b}]}
  end

  def execute(%Credit{account_ref: id, amount: amt}, %{store: store}, _runtime) do
    new_balance = Agent.get(store, & &1[id].balance) + amt
    Agent.update(store, &put_in(&1, [id, :balance], new_balance))
    {:ok, [%Credited{account_id: id, amount: amt, new_balance: new_balance}]}
  end

  def execute(%Debit{account_ref: id, amount: amt}, %{store: store}, _runtime) do
    balance = Agent.get(store, & &1[id].balance)

    if balance >= amt do
      Agent.update(store, &put_in(&1, [id, :balance], balance - amt))
      {:ok, [%Debited{account_id: id, amount: amt, new_balance: balance - amt}]}
    else
      {:ok, [%DebitRejected{account_id: id, amount: amt, reason: :insufficient_funds}]}
    end
  end
end
```

## Part 2 — Run the property test

`PropertyDamage.run/1` generates command sequences, executes them through the
adapter, folds the resulting events through the projections, and checks the
invariant after every step. We pass `coverage: true` so the next section can
report how thoroughly the model was exercised.

Against the correct adapter this returns `{:ok, stats}`.

```elixir
result =
  PropertyDamage.run(
    model: Demo.Model,
    adapter: Demo.BankAdapter,
    max_commands: 25,
    max_runs: 100,
    seed: 42,
    coverage: true
  )
```

## Part 3 — Coverage: is the green result trustworthy?

A passing run means nothing if a command was never generated or the invariant
never actually ran. Coverage makes the result trustworthy. Because we ran with
`coverage: true`, the result carries a merged tracker;
`PropertyDamage.coverage/2` pulls it out and `PropertyDamage.Coverage.format/2`
renders it.

```elixir
coverage = PropertyDamage.coverage(result, Demo.Model)
Kino.Markdown.new("```\n" <> PropertyDamage.Coverage.format(coverage, :summary) <> "\n```")
```

`PropertyDamage.assertion_coverage/2` joins the run's assertion firings against
the invariant catalog — an invariant that never fired is a *vacuous* guarantee.
Here `balance_non_negative` should show `covered?: true` with a large fire count.

```elixir
rows =
  for inv <- PropertyDamage.assertion_coverage(result, Demo.Model) do
    %{invariant: inv.id, covered?: inv.covered?, fire_count: inv.fire_count}
  end

Kino.DataTable.new(rows)
```

```elixir
# Any invariant the run never exercised (empty list here = fully exercised):
PropertyDamage.Coverage.uncovered_invariants(coverage)
```

## Part 4 — Introduce a bug, then debug it

Now the interesting part. We swap in a **buggy** adapter that forgets to check
the balance before debiting, so overdrafts slip through. The model and its
invariant are unchanged — only the SUT is wrong.

```elixir
defmodule Demo.BuggyBankAdapter do
  use PropertyDamage.Adapter

  alias Demo.Commands.{OpenAccount, Credit, Debit}
  alias Demo.Events.{AccountOpened, Credited, Debited}

  @impl true
  def setup(_config) do
    {:ok, store} = Agent.start_link(fn -> %{} end)
    {:ok, %{store: store}}
  end

  @impl true
  def teardown(%{store: store}), do: Agent.stop(store)

  @impl true
  def execute(%OpenAccount{currency: c, opening_balance: b}, %{store: store}, _runtime) do
    id = "acc_#{System.unique_integer([:positive])}"
    Agent.update(store, &Map.put(&1, id, %{currency: c, balance: b}))
    {:ok, [%AccountOpened{account_id: id, currency: c, opening_balance: b}]}
  end

  def execute(%Credit{account_ref: id, amount: amt}, %{store: store}, _runtime) do
    new_balance = Agent.get(store, & &1[id].balance) + amt
    Agent.update(store, &put_in(&1, [id, :balance], new_balance))
    {:ok, [%Credited{account_id: id, amount: amt, new_balance: new_balance}]}
  end

  def execute(%Debit{account_ref: id, amount: amt}, %{store: store}, _runtime) do
    # BUG: no funds check -- overdrafts are silently allowed.
    new_balance = Agent.get(store, & &1[id].balance) - amt
    Agent.update(store, &put_in(&1, [id, :balance], new_balance))
    {:ok, [%Debited{account_id: id, amount: amt, new_balance: new_balance}]}
  end
end
```

Run against the buggy adapter. PropertyDamage finds a violating sequence, shrinks
it, and returns `{:error, failure}`.

```elixir
{:error, failure} =
  PropertyDamage.run(
    model: Demo.Model,
    adapter: Demo.BuggyBankAdapter,
    max_commands: 25,
    max_runs: 100,
    seed: 42
  )

%{
  failure_type: PropertyDamage.FailureReport.failure_type(failure),
  check_name: PropertyDamage.FailureReport.check_name(failure),
  seed: failure.seed
}
```

### The shrunk sequence

`shrunk_sequence/1` is the minimal reproduction — every command in it is
necessary. Expect something like *open an account, then debit more than its
balance*.

```elixir
failure
|> PropertyDamage.FailureReport.shrunk_sequence()
|> PropertyDamage.Sequence.to_list()
|> Enum.with_index()
|> Enum.map_join("\n", fn {cmd, idx} -> "[#{idx}] #{inspect(cmd)}" end)
|> Kino.Markdown.new()
```

### Step-by-step replay

`replay/2` re-executes the shrunk sequence and returns each step with its command,
resulting events, and projection state — the play-by-play of how the balance went
negative.

```elixir
{:ok, steps} = PropertyDamage.replay(failure)

steps
|> Enum.map_join("\n\n", fn step ->
  """
  === Step #{step.index} ===
  Command: #{inspect(step.command)}
  Events:  #{inspect(step.events)}
  State:   #{inspect(step.projections)}
  """
end)
|> Kino.Markdown.new()
```

### A sequence diagram

`Diagram.from_failure_report/2` renders the failing sequence as a Mermaid
diagram, which Livebook draws inline via `Kino.Mermaid`.

```elixir
failure
|> PropertyDamage.Diagram.from_failure_report(:mermaid)
|> Kino.Mermaid.new()
```

### Freeze it into a regression test

`Export.to_exunit/1` turns the failure into a standalone ExUnit test that replays
the exact shrunk sequence — a durable regression that survives generator changes.

```elixir
test_code = PropertyDamage.Export.to_exunit(failure)
Kino.Markdown.new("```elixir\n" <> test_code <> "\n```")
```

Other debugging tools worth knowing (see the *Debugging Failures* guide):
`PropertyDamage.explain/1` for a per-command rationale,
`PropertyDamage.isolate_trigger/1` to pin down the offending field, and
`PropertyDamage.save_failure/2` to persist a `.pd` file for `mix pd.replay` /
`mix pd.bisect`:

```elixir
{:ok, path} = PropertyDamage.save_failure(failure, "failures/")
path
```

## Part 5 — Chaos engineering with a nemesis

A **nemesis** injects faults so you can test resilience. `NetworkLatency` degrades
the SUT's network path when a Toxiproxy endpoint is configured in the adapter
context; without one it runs in **simulated** mode (a no-op that still tags its
event), which is perfect for a self-contained demo.

You can see the marker directly:

```elixir
alias PropertyDamage.Nemesis.NetworkLatency

{:ok, [event]} = NetworkLatency.inject(%NetworkLatency{latency_ms: 100, jitter_ms: 20}, %{})
%{simulated?: PropertyDamage.Nemesis.simulated_event?(event)}
```

To wire a nemesis into a run, add it to the model's `commands/0` with a low weight.
Its injected/restored events (`NetworkLatencyInjected` / `NetworkLatencyRestored`)
flow through your projection like any other, so you can count active faults. The
balance invariant must still hold under (simulated) latency, so the run passes.

```elixir
defmodule Demo.ChaosBank do
  use PropertyDamage.Model.Projection

  alias Demo.Events.{AccountOpened, Credited, Debited, DebitRejected}

  @impl true
  def init, do: %{accounts: %{}, faults: 0}

  @impl true
  def apply(state, %AccountOpened{account_id: id, currency: c, opening_balance: b}) do
    put_in(state, [:accounts, id], %{currency: c, balance: b})
  end

  def apply(state, %Credited{account_id: id, new_balance: nb}) do
    if Map.has_key?(state.accounts, id),
      do: put_in(state, [:accounts, id, :balance], nb),
      else: state
  end

  def apply(state, %Debited{account_id: id, new_balance: nb}) do
    if Map.has_key?(state.accounts, id),
      do: put_in(state, [:accounts, id, :balance], nb),
      else: state
  end

  def apply(state, %DebitRejected{}), do: state
  def apply(state, %NetworkLatencyInjected{}), do: update_in(state, [:faults], &(&1 + 1))
  def apply(state, %NetworkLatencyRestored{}), do: state
  def apply(state, _event), do: state

  @trigger every: 1
  def assert_balance_non_negative(state, _step) do
    negative = Enum.filter(state.accounts, fn {_id, acct} -> acct.balance < 0 end)

    unless negative == [] do
      PropertyDamage.fail!("account balance went negative", accounts: negative)
    end
  end
end

defmodule Demo.ChaosModel do
  @behaviour PropertyDamage.Model

  alias Demo.Commands.{OpenAccount, Credit, Debit}
  alias PropertyDamage.Nemesis.NetworkLatency

  @impl true
  def commands do
    [
      {OpenAccount, weight: 3},
      {Credit,
       weight: 3,
       when: fn s -> map_size(s.accounts) > 0 end,
       with: fn s -> %{account_ref: StreamData.member_of(Map.keys(s.accounts))} end},
      {Debit,
       weight: 3,
       when: fn s -> map_size(s.accounts) > 0 end,
       with: fn s -> %{account_ref: StreamData.member_of(Map.keys(s.accounts))} end},
      # Low weight = occasional faults.
      {NetworkLatency, weight: 1}
    ]
  end

  @impl true
  def command_sequence_projection, do: Demo.ChaosBank

  @impl true
  def assertion_projections, do: [Demo.ChaosBank]

  @impl true
  def simulator, do: Demo.Simulator
end

PropertyDamage.run(
  model: Demo.ChaosModel,
  adapter: Demo.BankAdapter,
  max_commands: 20,
  max_runs: 30,
  seed: 7
)
```

To make the fault *real*, have your adapter's `setup/1` return
`%{toxiproxy: %{proxy_name: ..., api_url: ...}}` and route the SUT through that
proxy. See the **Chaos Engineering** guide for the live Toxiproxy recipe.

