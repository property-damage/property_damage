# PropertyDamage Interactive Demo

```elixir
Mix.install([
  {:property_damage, path: ".."},
  {:kino, "~> 0.12"},
  {:vega_lite, "~> 0.1"},
  {:kino_vega_lite, "~> 0.1"}
])
```

## Introduction

This notebook demonstrates PropertyDamage's Livebook integration for interactive
exploration of stateful property-based testing. You'll learn how to:

- Define models, commands, and projections
- Run tests with live visualization
- Analyze coverage and failures
- Use chaos engineering with nemesis operations

## Part 1: Define a Simple Model

Let's create a bank account model to demonstrate PropertyDamage concepts.

### Events

Events represent outcomes of operations:

```elixir
defmodule Demo.Events do
  defmodule AccountCreated do
    defstruct [:account_id, :currency, :balance]
  end

  defmodule Credited do
    defstruct [:account_id, :amount, :new_balance]
  end

  defmodule Debited do
    defstruct [:account_id, :amount, :new_balance]
  end

  defmodule DebitFailed do
    defstruct [:account_id, :amount, :reason]
  end
end
```

### Commands

Commands represent operations that can be executed:

```elixir
defmodule Demo.Commands.CreateAccount do
  @behaviour PropertyDamage.Command

  alias Demo.Events.AccountCreated

  defstruct [:currency, :initial_balance]

  @impl true
  def new!(_state, _overrides \\ %{}) do
    import StreamData

    bind(member_of(["USD", "EUR", "GBP"]), fn currency ->
      bind(integer(0..10000), fn balance ->
        constant(%__MODULE__{
          currency: currency,
          initial_balance: balance
        })
      end)
    end)
  end

  @impl true
  def precondition(_state), do: true

  @impl true
  def ref(_cmd, events) do
    case events do
      [%AccountCreated{account_id: id} | _] -> id
      _ -> nil
    end
  end
end

defmodule Demo.Commands.Credit do
  @behaviour PropertyDamage.Command

  defstruct [:account_ref, :amount]

  @impl true
  def new!(state, _overrides \\ %{}) do
    import StreamData

    accounts = Map.keys(state[:accounts] || %{})

    if Enum.empty?(accounts) do
      nil
    else
      bind(member_of(accounts), fn account_ref ->
        bind(integer(1..5000), fn amount ->
          constant(%__MODULE__{
            account_ref: account_ref,
            amount: amount
          })
        end)
      end)
    end
  end

  @impl true
  def precondition(state) do
    map_size(state[:accounts] || %{}) > 0
  end

  @impl true
  def ref(_cmd, _events), do: nil
end

defmodule Demo.Commands.Debit do
  @behaviour PropertyDamage.Command

  defstruct [:account_ref, :amount]

  @impl true
  def new!(state, _overrides \\ %{}) do
    import StreamData

    accounts = Map.keys(state[:accounts] || %{})

    if Enum.empty?(accounts) do
      nil
    else
      bind(member_of(accounts), fn account_ref ->
        bind(integer(1..5000), fn amount ->
          constant(%__MODULE__{
            account_ref: account_ref,
            amount: amount
          })
        end)
      end)
    end
  end

  @impl true
  def precondition(state) do
    map_size(state[:accounts] || %{}) > 0
  end

  @impl true
  def ref(_cmd, _events), do: nil
end
```

### Projections

Projections maintain state and check invariants:

```elixir
defmodule Demo.Projections.ModelState do
  @behaviour PropertyDamage.Projection

  alias Demo.Events.{AccountCreated, Credited, Debited, DebitFailed}

  @impl true
  def init, do: %{accounts: %{}}

  @impl true
  def apply(state, %AccountCreated{account_id: id, currency: currency, balance: balance}) do
    put_in(state, [:accounts, id], %{currency: currency, balance: balance})
  end

  def apply(state, %Credited{account_id: id, new_balance: balance}) do
    put_in(state, [:accounts, id, :balance], balance)
  end

  def apply(state, %Debited{account_id: id, new_balance: balance}) do
    put_in(state, [:accounts, id, :balance], balance)
  end

  def apply(state, %DebitFailed{}), do: state
  def apply(state, _), do: state
end

defmodule Demo.Projections.AccountInvariants do
  @behaviour PropertyDamage.Projection

  alias Demo.Events.{AccountCreated, Credited, Debited}

  @impl true
  def init, do: %{balances: %{}}

  @impl true
  def apply(state, %AccountCreated{account_id: id, balance: balance}) do
    put_in(state, [:balances, id], balance)
  end

  def apply(state, %Credited{account_id: id, amount: amount}) do
    update_in(state, [:balances, id], &(&1 + amount))
  end

  def apply(state, %Debited{account_id: id, amount: amount}) do
    update_in(state, [:balances, id], &(&1 - amount))
  end

  def apply(state, _), do: state

  # Invariant checks
  def __checks__ do
    [
      %{name: :balance_never_negative, trigger: :always, sample: 1}
    ]
  end

  def check(:balance_never_negative, state, _ctx) do
    negative =
      state.balances
      |> Enum.filter(fn {_id, balance} -> balance < 0 end)

    if Enum.empty?(negative) do
      :ok
    else
      {:error, "Negative balances found: #{inspect(negative)}"}
    end
  end
end
```

### Model

The model ties everything together:

```elixir
defmodule Demo.Model do
  @behaviour PropertyDamage.Model

  alias Demo.Commands.{CreateAccount, Credit, Debit}
  alias Demo.Projections.{ModelState, AccountInvariants}

  @impl true
  def commands do
    [
      {5, CreateAccount},
      {3, Credit},
      {3, Debit}
    ]
  end

  @impl true
  def state_projection, do: ModelState

  @impl true
  def assertion_projections, do: [AccountInvariants]

  @impl true
  def injectable_events, do: []
end
```

### Adapter

The adapter executes commands against the system under test:

```elixir
defmodule Demo.Adapter do
  @behaviour PropertyDamage.Adapter

  alias Demo.Events.{AccountCreated, Credited, Debited, DebitFailed}
  alias Demo.Commands.{CreateAccount, Credit, Debit}

  # In-memory "database"
  @impl true
  def setup(_config) do
    {:ok, %{accounts: %{}, next_id: 1}}
  end

  @impl true
  def teardown(_ctx), do: :ok

  @impl true
  def execute(%CreateAccount{currency: currency, initial_balance: balance}, ctx) do
    id = "acc_#{ctx.next_id}"

    new_ctx = %{
      ctx
      | accounts: Map.put(ctx.accounts, id, %{currency: currency, balance: balance}),
        next_id: ctx.next_id + 1
    }

    events = [%AccountCreated{account_id: id, currency: currency, balance: balance}]
    {:ok, events, new_ctx}
  end

  def execute(%Credit{account_ref: id, amount: amount}, ctx) do
    account = ctx.accounts[id]
    new_balance = account.balance + amount

    new_ctx = put_in(ctx, [:accounts, id, :balance], new_balance)
    events = [%Credited{account_id: id, amount: amount, new_balance: new_balance}]

    {:ok, events, new_ctx}
  end

  def execute(%Debit{account_ref: id, amount: amount}, ctx) do
    account = ctx.accounts[id]

    # BUG: Allow negative balance (intentional for demo)
    new_balance = account.balance - amount

    new_ctx = put_in(ctx, [:accounts, id, :balance], new_balance)
    events = [%Debited{account_id: id, amount: amount, new_balance: new_balance}]

    {:ok, events, new_ctx}
  end
end
```

## Part 2: Run Tests with Visualization

Now let's run the tests with live visualization:

```elixir
alias PropertyDamage.Livebook

# Run with live progress updates
result = Livebook.run_with_visualization(
  model: Demo.Model,
  adapter: Demo.Adapter,
  max_runs: 20,
  max_commands: 15
)
```

## Part 3: Visualize Results

### Main Dashboard

The `visualize/1` function creates a tabbed dashboard with all visualizations:

```elixir
Livebook.visualize(result)
```

### Results Table

View command execution history in a sortable, filterable table:

```elixir
Livebook.results_table(result)
```

### Command Statistics

See execution counts and timing for each command type:

```elixir
Livebook.command_stats(result)
```

## Part 4: Charts and Graphs

### Command Execution Chart

```elixir
alias PropertyDamage.Livebook.Charts

Charts.command_bar_chart(result)
```

### Timing Distribution

```elixir
Charts.timing_histogram(result)
```

### Success Rate

```elixir
Charts.success_pie_chart(result)
```

### Command Transitions

See which commands follow which (useful for coverage analysis):

```elixir
Charts.command_transition_heatmap(result)
```

## Part 5: Interactive Command Stepper

Step through command execution one at a time to understand failures:

```elixir
Livebook.command_stepper(result)
```

## Part 6: Coverage Analysis

Analyze how thoroughly your model was exercised:

```elixir
coverage = PropertyDamage.Coverage.from_result(result)
PropertyDamage.Coverage.format_summary(coverage)
```

## Part 7: Chaos Engineering with Nemesis

PropertyDamage includes nemesis operations for fault injection.
Here's how to use them:

```elixir
# Example: Simulating network latency
alias PropertyDamage.Nemesis.NetworkLatency

latency_cmd = %NetworkLatency{
  latency_ms: 100,
  jitter_ms: 20,
  duration_ms: 5000
}

# Inject the fault
{:ok, events} = NetworkLatency.inject(latency_cmd, %{})
IO.inspect(events, label: "Latency injected")

# Check if latency should be applied
NetworkLatency.should_delay?()

# Restore normal operation
{:ok, _} = NetworkLatency.restore(latency_cmd, %{})
```

### Certificate Expiry Simulation

```elixir
alias PropertyDamage.Nemesis.CertificateExpiry

cert_cmd = %CertificateExpiry{
  failure_type: :expired,
  target: :api,
  duration_ms: 10000
}

# Inject certificate failure
{:ok, events} = CertificateExpiry.inject(cert_cmd, %{})
IO.inspect(events, label: "Certificate failure injected")

# Check if requests should fail
CertificateExpiry.should_fail?(:api)

# Get the SSL error that would be returned
CertificateExpiry.get_ssl_error()

# Restore
{:ok, _} = CertificateExpiry.restore(cert_cmd, %{})
```

