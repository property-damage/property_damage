{
  "openapi": "3.0.3",
  "info": {
    "title": "KV Register API",
    "version": "1.0.0",
    "description": "A minimal integer-keyed value register, used as the SUT for the PropertyDamage OpenAPI/REST scaffold bench (6e)."
  },
  "servers": [
    {
      "url": "http://localhost:4010"
    }
  ],
  "paths": {
    "/kv/{key}": {
      "put": {
        "operationId": "putValue",
        "summary": "Store a value under a key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["value"],
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The stored key/value pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getValue",
        "summary": "Read the value stored under a key",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The stored key/value pair",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            }
          },
          "404": {
            "description": "No value stored under that key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Entry": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "integer"
          },
          "value": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
